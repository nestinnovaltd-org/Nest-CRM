NODE_ENV=production
PORT=3001

# Frontend URL (Vercel) — required for CORS
ALLOWED_ORIGIN=https://your-crm.vercel.app

# Supabase — service role key stays ONLY on VPS backend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Redis (local to VPS)
REDIS_URL=redis://127.0.0.1:6379

# WhatsApp session storage (absolute VPS path, NOT inside this repo)
WHATSAPP_SESSION_PATH=/var/www/crm/whatsapp-sessions

# Logging
LOG_LEVEL=info

# Campaign safety floors (hard minimums — workers enforce these)
SAFETY_MIN_DELAY_SECONDS=8
SAFETY_MAX_DAILY_LIMIT=500
SAFETY_MAX_HOURLY=50
